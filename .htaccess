# =============================================
#  StudeerSamen CMS — Apache beveiligingsconfiguratie
# =============================================

# Verberg directorylijst
Options -Indexes

# Bescherm config.php tegen directe toegang
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Bescherm JSON content-bestanden tegen directe toegang
<FilesMatch "\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bescherm het wachtwoord-hashbestand
<Files ".adminpass">
    Order Allow,Deny
    Deny from all
</Files>

# Bescherm verborgen bestanden (beginnen met punt)
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# mod_rewrite: HTTPS afdwingen + clean URL
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Forceer HTTPS (verwijder de # om te activeren op live server) ──
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect /admin → /admin/
    RewriteRule ^admin$ admin/ [R=301,L]
</IfModule>

# Beveiligingsheaders
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Schakel PHP-foutweergave uit in productie
php_flag display_errors off
php_flag log_errors on
